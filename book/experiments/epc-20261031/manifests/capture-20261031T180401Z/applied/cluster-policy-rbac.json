    {
      "apiVersion": "admissionregistration.k8s.io/v1",
      "kind": "ValidatingAdmissionPolicy",
      "metadata": {
        "creationTimestamp": "2026-10-31T17:49:17Z",
        "generation": 1,
        "name": "sandboxconfig-assets",
        "resourceVersion": "903",
        "uid": "3fb5f242-1f75-4622-89e2-da2896061398"
      },
      "spec": {
        "failurePolicy": "Fail",
        "matchConstraints": {
          "matchPolicy": "Equivalent",
          "namespaceSelector": {},
          "objectSelector": {},
          "resourceRules": [
            {
              "apiGroups": [
                "ate.dev"
              ],
              "apiVersions": [
                "v1"
              ],
              "operations": [
                "CREATE",
                "UPDATE"
              ],
              "resources": [
                "sandboxconfigs"
              ],
              "scope": "*"
            }
          ]
        },
        "validations": [
          {
            "expression": "object.spec.sandboxClass != 'gvisor' || object.spec.versions.all(v,\n  has(v.assets) && size(v.assets) > 0 &&\n  v.assets.all(arch, 'gvisor' in v.assets[arch]))",
            "message": "a gvisor SandboxConfig must define a 'gvisor' (release tarball) asset for every architecture of every version under spec.versions[].assets"
          },
          {
            "expression": "object.spec.sandboxClass != 'microvm' || object.spec.versions.all(v,\n  has(v.assets) && size(v.assets) > 0 &&\n  v.assets.all(arch,\n    ['cloud-hypervisor', 'virtiofsd', 'kata-kernel', 'kata-image']\n      .all(name, name in v.assets[arch])))",
            "message": "a microvm SandboxConfig must define cloud-hypervisor, virtiofsd, kata-kernel, and kata-image assets for every architecture of every version under spec.versions[].assets"
          }
        ]
      }
    },
